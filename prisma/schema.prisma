generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Admin {
  id_admin     Int          @id(map: "PK__Admin__89472E95DB2049D4") @default(autoincrement())
  id_community Int?
  user_name    String?      @db.VarChar(50) @unique
  Community    Community?   @relation(fields: [id_community], references: [id_community], onDelete: NoAction, onUpdate: NoAction, map: "FK__Admin__id_commun__6D0D32F4")
  Member       Member?      @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK_Admin_Member")
  Tournament   Tournament[]
}

model Community {
  id_community     Int                @id(map: "PK__Communit__5EB0F0780885BDE2") @default(autoincrement())
  name             String?
  details          String?
  avatar           String?            @db.VarChar(255)
  members          Int?
  location         String?            @db.VarChar(100)
  id_manager       Int?
  created          String?
  privacy          Boolean?
  Admin            Admin[]
  Manager          Manager?           @relation(fields: [id_manager], references: [id_manager], onDelete: NoAction, onUpdate: NoAction, map: "FK_Community_Manager")
  Community_member Community_member[]
  Tournament       Tournament[]
}

model Community_member {
  id_co_member Int        @id(map: "PK__Communit__E973ECDD1047C6B9") @default(autoincrement())
  join_date    DateTime?  @db.Date
  id_community Int?       
  user_name    String?    @db.VarChar(50)
  Community    Community? @relation(fields: [id_community], references: [id_community], onDelete: NoAction, onUpdate: NoAction, map: "FK__Community__id_co__5165187F")
  Member       Member?    @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK__Community__user___52593CB8")
   @@unique([user_name, id_community])
}

model Employee {
  user_name String   @id(map: "PK__Employee__7C9273C569FB6D8F") @db.VarChar(50)
  retraite  Boolean?
  Member    Member   @relation(fields: [user_name], references: [user_name], onUpdate: NoAction, map: "FK__Employee__user_na__59063A47")
}

model Manager {
  id_manager Int         @id(map: "PK__Manager__7F9D5D00A6100A19") @default(autoincrement())
  password   String?     @db.VarChar(255)
  Community  Community[]
}

model Member {
  user_name        String             @id(map: "PK__Member__7C9273C585C5662A") @db.VarChar(50)
  name             String?            @db.VarChar(50)
  surname          String?            @db.VarChar(50)
  address          String?            @db.VarChar(100)
  birth_date       DateTime?          @db.Date
  country          String?            @db.VarChar(50)
  email            String?            @db.VarChar(100)
  phone            String?            @db.VarChar(50)
  avatar           String?            @db.VarChar(255)
  password         String?            @db.VarChar(255)
  Admin            Admin?
  Community_member Community_member[]
  Employee         Employee?
  Player           Player[]
  Sponsor          Sponsor?
  Team             Team[]
  Team_member      Team_member[]
}

model Player {
  id_player  Int         @id(map: "PK__Player__45CF72B13D626897") @default(autoincrement())
  id_tour    Int?
  user_name  String?     @db.VarChar(50)
  Member     Member?     @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK__Player__user_nam__4CA06362")
  Tournament Tournament? @relation(fields: [id_tour], references: [id_tour], onDelete: NoAction, onUpdate: NoAction, map: "FK_Player_Tournament")
}

model Prize {
  id_prize      Int             @id(map: "PK__Prize__D8A0CD8857767C01") @default(autoincrement())
  name          String?         @db.VarChar(50)
  spots         Int?
  group_spot    Int?
  id_tour       Int?
  id_type       Int?
  id_admin      Int?
  Tournament    Tournament?     @relation(fields: [id_tour], references: [id_tour], onDelete: NoAction, onUpdate: NoAction, map: "FK__Prize__id_tour__656C112C")
  Type          Type?           @relation(fields: [id_type], references: [id_type], onDelete: NoAction, onUpdate: NoAction, map: "FK__Prize__id_type__66603565")
  Prize_sponsor Prize_sponsor[]
}

model Prize_sponsor {
  id_prize_sponsor Int      @id(map: "PK__Prize_sp__BFED9266AFAAE36A") @default(autoincrement())
  id_prize         Int?
  user_name        String?  @db.VarChar(50)
  Prize            Prize?   @relation(fields: [id_prize], references: [id_prize], onDelete: NoAction, onUpdate: NoAction, map: "FK__Prize_spo__id_pr__693CA210")
  Sponsor          Sponsor? @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK__Prize_spo__user___6A30C649")
}

model Sponsor {
  user_name     String          @id(map: "PK__Sponsor__7C9273C5672D81F4") @db.VarChar(50)
  company_name  String?         @db.VarChar(100)
  title         String?         @db.VarChar(100)
  Prize_sponsor Prize_sponsor[]
  Member        Member          @relation(fields: [user_name], references: [user_name], onUpdate: NoAction, map: "FK__Sponsor__user_na__59063A47")
}

model Team {
  id_team     Int           @id(map: "PK__Team__C6D204E78433FB0F") @default(autoincrement())
  name        String?       @db.VarChar(50)
  members     Int?
  players     Int?
  id_tour     Int?
  key_team    String?       @db.VarChar(50)
  open        Boolean?      @map("_open")
  user_name   String?       @db.VarChar(50)
  Tournament  Tournament?   @relation(fields: [id_tour], references: [id_tour], onDelete: NoAction, onUpdate: NoAction, map: "FK__Team__id_tour__5BE2A6F2")
  Member      Member?       @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK__Team__user_name__5CD6CB2B")
  Team_member Team_member[]
}

model Team_member {
  id_team_member Int      @id(map: "PK__Team_mem__36EAACFC07AC4600") @default(autoincrement())
  id_team        Int?
  user_name      String?  @db.VarChar(50)
  status         Boolean?
  Team           Team?    @relation(fields: [id_team], references: [id_team], onDelete: NoAction, onUpdate: NoAction, map: "FK__Team_memb__id_te__5FB337D6")
  Member         Member?  @relation(fields: [user_name], references: [user_name], onDelete: NoAction, onUpdate: NoAction, map: "FK__Team_memb__user___60A75C0F")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Test {
  patate String? @db.VarChar(100)
  yvan   String? @db.VarChar(10)

  @@ignore
}

model Tournament {
  id_tour      Int        @id(map: "PK__Tourname__C9304CF6ECB8D893") @default(autoincrement())
  name         String?     @db.VarChar(100)
  location     String?    @db.VarChar(100)
  start_date   DateTime?  @db.Date
  end_date     DateTime?  @db.Date
  status       Int?       @default(0)
  members      Int?       
  avatar       String?    @db.VarChar(255)
  id_admin     Int?
  id_community Int?
  fees         Float?
  Player       Player[]
  Prize        Prize[]
  Team         Team[]
  Admin        Admin?     @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "FK_Tournament_Admin")
  Community    Community? @relation(fields: [id_community], references: [id_community], onDelete: NoAction, onUpdate: NoAction, map: "FK_Tournament_Community")
}

model Type {
  id_type Int     @id(map: "PK__Type__C3F091E0EDEEA9E9") @default(autoincrement())
  name    String? @db.VarChar(50)
  Prize   Prize[]
}
